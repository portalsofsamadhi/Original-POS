## Example environment — Portals of Samadhi (Original-POS)
## Copy to .env.local (frontend) and server/.env (API). Do NOT commit real secrets.

# --- Vite build-time (frontend) ---
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Must be a publishable key starting with pk_ (never sk_)
VITE_STRIPE_PUBLIC_KEY=pk_live_or_pk_test_xxx
VITE_PAYPAL_CLIENT_ID=your-paypal-client-id
VITE_APP_URL=https://www.portalsofsamadhi.com
# Empty = same-origin /api (recommended for single Render web service)
VITE_API_URL=
VITE_NEWSLETTER_API_URL=

# Local dev only
# VITE_APP_URL=http://localhost:3002
# Leave VITE_API_URL empty and run: npm run dev  (proxy /api -> :10000)

# --- Server runtime (server/.env or Render dashboard) ---
TEAM_EMAIL=info@portalsofsamadhi.com
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_USER=info@portalsofsamadhi.com
SMTP_PASS=your_zoho_app_password
SMTP_FROM="Portals of Samadhi <info@portalsofsamadhi.com>"
STRIPE_SECRET_KEY=sk_live_or_sk_test_xxx
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://www.portalsofsamadhi.com/profile
FRONTEND_URL=https://www.portalsofsamadhi.com
JWT_SECRET=change-me
ADMIN_BEARER_TOKEN=Bearer change-me
