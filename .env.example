## Example environment file for local development
## Copy this to .env.local and fill in real values. Do NOT commit .env.local.

# --- Google OAuth (frontend) ---
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Google OAuth (server) ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Stripe (frontend) ---
VITE_STRIPE_PUBLIC_KEY=pk_test_xxx

# --- PayPal (frontend) ---
VITE_PAYPAL_CLIENT_ID=your-paypal-client-id

# --- App URLs ---
VITE_APP_URL=http://localhost:5173
# Leave empty in dev to use Vite proxy (/api -> localhost:10000). Run: npm run dev:full
VITE_API_URL=

# --- Other (optional) ---
VITE_NEWSLETTER_API_URL=http://localhost:3000

# Notes:
# 1) Copy this file to .env.local:  cp .env.example .env.local (or use the provided PowerShell helper)
# 2) .env.local is ignored by git (see .gitignore)
# 3) For production, set secrets on your host provider (Render, Vercel, etc.)
# Example environment variables (DO NOT COMMIT SECRETS)
# Copy this file to `.env` locally and fill in real values. Do NOT commit your real `.env` file.

# --- Vite build-time public variables (prefixed with VITE_). These are baked into the frontend at build time.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_STRIPE_PUBLIC_KEY=pk_test_or_pk_live_xxx
VITE_PAYPAL_CLIENT_ID=your-paypal-client-id
VITE_NEWSLETTER_API_URL=https://your-api.example.com
VITE_APP_URL=https://www.portalsofsamadhi.com
VITE_API_URL=https://your-api.example.com
VITE_EMAIL_USER=you@example.com

# --- Server-side runtime secrets (do NOT store these in the frontend repo if you can avoid it)
# These are used by the Node backend and should be set in your server environment (not the static frontend build).
MONGODB_URI=mongodb://<username>:<password>@host:port/dbname
JWT_SECRET=super-secret-jwt-value
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# PayPal Configuration
# For development, use sandbox credentials
# For production, use live credentials

# PayPal Client ID (you'll need to get this from PayPal Developer Dashboard)
VITE_PAYPAL_CLIENT_ID=REDACTED_PAYPAL_CLIENT_ID

# Environment (sandbox or production)
NODE_ENV=development
